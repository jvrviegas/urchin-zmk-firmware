// Direct 34-key adaptation of ../zmk-config-totem/config/totem.keymap.
// The Totem's two outer bottom-row keys and two outer thumb keys are omitted.

// Layer diagrams: "TAP/HOLD" = tap for the first, hold for the second,
// "~" = transparent (falls through to Base), blank = does nothing.
// Combos (press together): Q+W = TAB (not in Game Lower), U+Y = `, Y+; = DEL, ,+. = '
// Game mode: toggled from Device. While on, holding LOWER gives Game Lower instead of Lower.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define GAME 3
#define GAME_LOWER 4
#define DEVICE 5

/ {
    combos {
        compatible = "zmk,combos";

        combo_sqt {
            timeout-ms = <50>;
            key-positions = <27 28>;
            bindings = <&kp SQT>;
        };

        combo_grave {
            timeout-ms = <50>;
            key-positions = <8 7>;
            bindings = <&kp GRAVE>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp TAB>;
            layers = <BASE LOWER RAISE GAME DEVICE>;
        };

        combo_delete {
            timeout-ms = <50>;
            key-positions = <8 9>;
            bindings = <&kp DELETE>;
        };
    };

    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <90>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <90>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        HMShiftR: HMShiftR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <60>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };

        HMShiftL: HMShiftL {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <60>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        CustomLT: CustomLT {
            compatible = "zmk,behavior-hold-tap";
            label = "CUSTOMLT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
            quick-tap-ms = <75>;
            hold-while-undecided;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base
        //
        // ╭───────┬───────┬───────┬───────┬───────╮   ╭───────┬───────┬───────┬───────┬───────╮
        // │   Q   │   W   │   F   │   P   │   B   │   │   J   │   L   │   U   │   Y   │   ;   │
        // ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
        // │ A/GUI │ R/ALT │ S/CTL │ T/SFT │   G   │   │   M   │ N/SFT │ E/CTL │ I/ALT │ O/GUI │
        // ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
        // │   Z   │   X   │   C   │   D   │   V   │   │   K   │   H   │   ,   │   .   │   /   │
        // ╰───────┴───────┴───────┴───────┴───────╯   ╰───────┴───────┴───────┴───────┴───────╯
        //               ╭────────────┬────────────╮   ╭────────────┬────────────╮
        //               │   LOWER    │   SPACE    │   │   ENTER    │ BSPC/RAISE │
        //               ╰────────────┴────────────╯   ╰────────────┴────────────╯
        default_layer {
            display-name = "Base";
            bindings = <
                &kp Q         &kp W         &kp F          &kp P               &kp B      &kp J  &kp L              &kp U         &kp Y       &kp SEMICOLON
                &HML LGUI A   &HML LALT R   &HML LCTRL S  &HMShiftL LSHFT T   &kp G      &kp M  &HMShiftR RSHFT N &HMR RCTRL E   &HMR LALT I &HMR RGUI O
                &kp Z         &kp X         &kp C          &kp D               &kp V      &kp K  &kp H              &kp COMMA     &kp DOT     &kp FSLH
                                               &mo 1        &kp SPACE                       &kp RET               &CustomLT 2 BSPC
            >;
        };

        // Lower (hold LOWER)
        //
        // ╭───────┬───────┬───────┬───────┬───────╮   ╭───────┬───────┬───────┬───────┬───────╮
        // │   1   │   2   │   3   │   4   │   5   │   │   6   │   7   │   8   │   9   │   0   │
        // ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
        // │   F1  │   F2  │   F3  │   F4  │   F5  │   │  LEFT │  DOWN │   UP  │ RIGHT │   ~   │
        // ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
        // │   F6  │   F7  │   F8  │   F9  │  F10  │   │  F11  │  F12  │   ~   │   ~   │   ~   │
        // ╰───────┴───────┴───────┴───────┴───────╯   ╰───────┴───────┴───────┴───────┴───────╯
        //               ╭────────────┬────────────╮   ╭────────────┬────────────╮
        //               │     ~      │   SPACE    │   │   ENTER    │     ~      │
        //               ╰────────────┴────────────╯   ╰────────────┴────────────╯
        lower_layer {
            display-name = "Lower";
            bindings = <
                &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6    &kp N7    &kp N8    &kp N9     &kp N0
                &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans
                &kp F6  &kp F7  &kp F8  &kp F9  &kp F10   &kp F11   &kp F12   &trans    &trans     &trans
                                      &trans  &kp SPACE             &kp RET   &trans
            >;
        };

        // Raise (hold RAISE)
        //
        // ╭───────┬───────┬───────┬───────┬───────╮   ╭───────┬───────┬───────┬───────┬───────╮
        // │   !   │   @   │   #   │   $   │   %   │   │   ^   │   &   │   *   │   (   │   )   │
        // ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
        // │   ~   │   ~   │   ~   │   ~   │   ~   │   │   -   │   =   │   [   │   ]   │   \   │
        // ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
        // │   ~   │   ~   │   ~   │   ~   │   ~   │   │   _   │   +   │   {   │   }   │   |   │
        // ╰───────┴───────┴───────┴───────┴───────╯   ╰───────┴───────┴───────┴───────┴───────╯
        //               ╭────────────┬────────────╮   ╭────────────┬────────────╮
        //               │     ~      │   SPACE    │   │   ENTER    │     ~      │
        //               ╰────────────┴────────────╯   ╰────────────┴────────────╯
        raise_layer {
            display-name = "Raise";
            bindings = <
                &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR
                &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH
                &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE
                                  &trans    &kp SPACE               &kp RET    &trans
            >;
        };

        // Game (toggled from Device) - changes nothing by itself, only switches LOWER to Game Lower
        game_layer {
            display-name = "Game";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans                    &trans  &trans
            >;
        };

        // Game Lower (hold LOWER while Game mode is on)
        //
        // ╭───────┬───────┬───────┬───────┬───────╮   ╭───────┬───────┬───────┬───────┬───────╮
        // │  ESC  │   F5  │   F6  │   F7  │   F8  │   │   ~   │   ~   │   ~   │   ~   │   ~   │
        // ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
        // │ ALT+Q │   F1  │   F2  │   F3  │   F4  │   │   ~   │   ~   │   ~   │   ~   │   ~   │
        // ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
        // │ ALT+A │ ALT+S │ ALT+E │   F9  │  F10  │   │   ~   │   ~   │   ~   │   ~   │   ~   │
        // ╰───────┴───────┴───────┴───────┴───────╯   ╰───────┴───────┴───────┴───────┴───────╯
        //               ╭────────────┬────────────╮   ╭────────────┬────────────╮
        //               │     ~      │     ~      │   │     ~      │     ~      │
        //               ╰────────────┴────────────╯   ╰────────────┴────────────╯
        // "~" here falls through to Lower (right half keeps numbers, arrows, F11, F12).
        game_lower_layer {
            display-name = "GmLower";
            bindings = <
                &kp ESC     &kp F5      &kp F6      &kp F7  &kp F8     &trans  &trans  &trans  &trans  &trans
                &kp LA(Q)   &kp F1      &kp F2      &kp F3  &kp F4     &trans  &trans  &trans  &trans  &trans
                &kp LA(A)   &kp LA(S)   &kp LA(E)   &kp F9  &kp F10    &trans  &trans  &trans  &trans  &trans
                                        &trans      &trans             &trans  &trans
            >;
        };

        // Device (hold LOWER + RAISE)
        //
        // ╭───────┬───────┬───────┬───────┬───────╮   ╭───────┬───────┬───────┬───────┬───────╮
        // │  CAPS │  BRI- │  BRI+ │  GAME │       │   │  BT 0 │  BT 1 │  BT 2 │  BT 3 │  ESC  │
        // ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
        // │  PREV │  NEXT │  VOL- │  VOL+ │  PLAY │   │       │       │       │       │       │
        // ├───────┼───────┼───────┼───────┼───────┤   ├───────┼───────┼───────┼───────┼───────┤
        // │       │       │       │       │   ~   │   │       │       │       │       │ BT CLR│
        // ╰───────┴───────┴───────┴───────┴───────╯   ╰───────┴───────┴───────┴───────┴───────╯
        //               ╭────────────┬────────────╮   ╭────────────┬────────────╮
        //               │            │            │   │            │            │
        //               ╰────────────┴────────────╯   ╰────────────┴────────────╯
        device {
            display-name = "Device";
            bindings = <
                &kp CAPSLOCK  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &tog GAME     &none       &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3     &kp ESC
                &kp C_PREV    &kp C_NEXT            &kp C_VOL_DN          &kp C_VOL_UP  &kp C_PP    &none  &none  &none  &none  &none
                &none         &none                 &none                 &none         &trans      &none  &none  &none  &none  &bt BT_CLR
                                                       &none                 &none                   &none           &none
            >;
        };

        extra_1 { status = "reserved"; };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        game_lower {
            if-layers = <LOWER GAME>;
            then-layer = <GAME_LOWER>;
        };

        device {
            if-layers = <LOWER RAISE>;
            then-layer = <DEVICE>;
        };
    };
};
